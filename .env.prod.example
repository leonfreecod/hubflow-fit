# Copie para um arquivo fora do Git e substitua todos os valores de exemplo.
DATABASE_NAME=hubflow
DATABASE_USERNAME=hubflow_app
DATABASE_PASSWORD=substitua_por_uma_senha_longa_e_exclusiva
JWT_SECRET=substitua_por_um_segredo_aleatorio_com_ao_menos_32_bytes
PIX_WEBHOOK_SECRET=substitua_por_outro_segredo_aleatorio_e_exclusivo

APP_ORIGIN=https://app.exemplo.com
APP_PORT=8080
JWT_EXPIRATION_MINUTES=30

# Opcional para portfólio: cria uma conta pública de administrador somente leitura.
# Esta senha é exibida no frontend quando o modo está ativo; não a reutilize em outro serviço.
SPRING_PROFILES_ACTIVE=prod,demo
PORTFOLIO_DEMO_ENABLED=true
PORTFOLIO_DEMO_EMAIL=demo@hubflow.fit
PORTFOLIO_DEMO_PASSWORD=123456
